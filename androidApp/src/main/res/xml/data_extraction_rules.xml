<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup/transfer: preserve metadata, exclude downloaded payloads.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline-downloads/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="offline-downloads/" />
    </device-transfer>
</data-extraction-rules>
